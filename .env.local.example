# Copy to `.env.local` for local development (never commit `.env.local`).
#
# --- Next.js → FastAPI proxy ---
# Leave BACKEND_URL unset locally so the App Router proxy targets http://127.0.0.1:8000.
# Set BACKEND_URL to the deployed FastAPI HTTPS base URL in Vercel project settings.
# BACKEND_URL=

# --- Browser / SSR (optional) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- FastAPI (loaded from repo root via backend/main.py) ---
# Chat & explanations — get a key from Google AI Studio
# GEMINI_API_KEY=

# Backend only. Omit DATABASE_URL locally to use SQLite at backend/sugarfree.db.
# Set to the private PostgreSQL connection string on the backend host.
# DATABASE_URL=

# Comma-separated origins for CORS (defaults include localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
